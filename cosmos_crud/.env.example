# Copy this file to .env.local / .env.dev / .env.uat / .env.prod and fill in real values.
# Never commit the real .env.* files — they are gitignored.
#
# Bare-Python local dev (no Docker): copy .env.local to .env
#   Windows: Copy-Item .env.local .env
#   Linux/macOS: cp .env.local .env

# ── Django ──────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=cosmoscrud.settings.local
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Cosmos DB ───────────────────────────────────────────────────────
# Leave COSMOS_DB_KEY blank in Azure so the Container App authenticates with
# its managed identity instead (Terraform grants it the "Cosmos DB Built-in
# Data Contributor" data-plane role). Locally, either run the Azure Cosmos DB
# Emulator (defaults below match it) or point at a real dev Cosmos account.
COSMOS_DB_ENDPOINT=https://localhost:8081
COSMOS_DB_KEY=
COSMOS_DB_DATABASE=appdb
COSMOS_DB_CONTAINER=items

# ── Container port ─────────────────────────────────────────────────
APP_PORT=8001
