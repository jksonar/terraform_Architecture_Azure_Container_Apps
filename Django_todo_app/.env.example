# Copy this file to .env.local / .env.dev / .env.uat / .env.prod and fill in real values.
# Never commit the real .env.* files — they are gitignored.
#
# Bare-Python local dev (no Docker): copy .env.local to .env
#   Windows: Copy-Item .env.local .env
#   Linux/macOS: cp .env.local .env

# ── Django ──────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=taskmanager.settings.local
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database (not used by local/SQLite) ────────────────────────────
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=replace-with-a-strong-password
DB_HOST=db
DB_PORT=5432

# ── Email (prod only) ──────────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password

# ── Container port ─────────────────────────────────────────────────
APP_PORT=8000
